# Reference list of environment values Umoja needs. This file is
# documentation only — it is NOT loaded at runtime by the app.
#
# Values are supplied at build/run time via --dart-define-from-file with a
# JSON file (see env.example.json in this directory and the root README).
#
# Never commit real credentials. The service-role key must NEVER appear
# here or anywhere in the Flutter app.

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Optional. The canonical public web URL this app is deployed at (e.g.
# https://app.example.org) — used only to build a shareable invitation
# link on native builds (Android/iOS/Linux/Windows/macOS); web builds
# use the browser's own origin instead. Leave empty until a real
# production web domain exists — see app_public_web_url usage in
# lib/core/config/env_config.dart. Never set this to a placeholder or
# localhost value for a release build.
APP_PUBLIC_WEB_URL=
